{
  "bot": {
    "host": "GrieferGames.net",
    "port": 25565,
    "username": "<microsoft-account-email>",
    "auth": "microsoft",
    "version": "1.8.9",
    "profilesFolder": "./profiles"
  },
  "startup": {
    "switchAfterJoinMs": 5000,
    "switchCommandDelayMs": 1000,
    "switchCommands": [
      "/switch <citybuild>"
    ],
    "dataLoadedMessage": "[GrieferGames] Deine Daten wurden vollständig heruntergeladen.",
    "homeAfterDataLoadedMs": 2000,
    "homeCommandDelayMs": 1000,
    "homeCommands": [
      "/home <name>",
      "/home <name>",
      "/home <name>"
    ]
  },
  "reconnect": {
    "enabled": true,
    "delayMs": 10000
  },
  "discord": {
    "enabled": true,
    "botToken": "<discord-bot-token>",
    "clientId": "<discord-application-id>",
    "guildId": "<discord-server-id>",
    "kickedChannelId": "<discord-kicked-channel-id>",
    "reconnectChannelId": "<discord-reconnect-channel-id>"
  }
}
